# ==============================================================================
#  THIS FILE IS ONLY A TEMPLATE - THE APP DOES *NOT* READ IT.
#
#  1. Copy it to a NEW file named exactly   .env   (same folder as app.py)
#  2. Edit the .env copy.   (Windows: make sure it is not saved as ".env.txt")
#  3. Restart the server. The startup banner must say ".env loaded" and
#     "OTP delivery : Firebase".  Then run:  python check_production.py
#
#  Never commit .env or share it: it holds your secrets.
# ==============================================================================

# ---- Mode ---------------------------------------------------------------------
# 0 = real use.   1 (or missing) = DEMO: fake voters, OTP shown on screen, admin/admin123.
DESHGARV_DEMO=0

# ---- Secrets: run  python make_secrets.py  and paste its 3 lines here -----------
SECRET_KEY=
DESHGARV_PEPPER=
ADMIN_PASSWORD_HASH=''
ADMIN_USERNAME=election-officer

# ---- OTP delivery: firebase (recommended) | twilio | msg91 --------------------------
SMS_PROVIDER=firebase

# Firebase: Project settings > General > Your apps > Web app. These are PUBLIC identifiers.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=       # = 'authDomain' (<project>.firebaseapp.com). NOT the storageBucket (.firebasestorage.app)
FIREBASE_APP_ID=
# DEV ONLY: skip reCAPTCHA so Firebase's fictional test numbers work (check_production.py fails while this is set)
# FIREBASE_TEST_MODE=1

# Twilio  (instead of Firebase: SMS_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# MSG91  (SMS_PROVIDER=msg91)
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# ---- Aadhaar verification: UIDAI "Offline e-KYC" file ----------------------------------
# offline_xml = every voter uploads the UIDAI-signed ZIP they download from myaadhaar.uidai.gov.in.
#               Needs UIDAI's public certificate in the folder uidai_certs/ (see uidai_certs/README.txt).
# off         = no check: anyone who knows an Aadhaar number can register as that person (demo only).
AADHAAR_KYC=offline_xml
# AADHAAR_XML_MAX_AGE_DAYS=3            # the file must be this recent
# AADHAAR_PHOTO_MATCH_THRESHOLD=0.68    # selfie vs UIDAI's tiny photo (measured: see README); keep 0.55 - 0.72
# AADHAAR_CHECK_MOBILE=1                # the typed mobile must be the Aadhaar-linked one
# MIN_VOTING_AGE=18                     # 0 = no age check
# UIDAI_CERT_DIR=uidai_certs

# ---- Behind an HTTPS reverse proxy (Caddy / nginx / cloud load balancer)? ----------
# 0 = visitors connect directly (e.g. testing on http://localhost:8000)
# 1 = exactly one proxy in front. Required in production, otherwise all voters share one rate limit.
TRUST_PROXY_HOPS=0

# ---- Elections --------------------------------------------------------------------
# Comma separated; every one needs candidates:  flask --app app add-candidate "Name" "Party" "Constituency"
DESHGARV_CONSTITUENCIES=New Delhi,Mumbai South

# ---- Optional tuning (defaults shown) ---------------------------------------------
# HOST=127.0.0.1        PORT=8000        THREADS=8
# LIVENESS=1            LIVENESS_STEPS=3
# LIVENESS_FLIP_DIRECTIONS=1   # your camera shows a MIRRORED picture, so left/right feel swapped (voters can also tap 'swap' on the page)
# LIVENESS_ANCHOR_CENTER=0.40    LIVENESS_ANCHOR_TURNED=0.55    LIVENESS_DETECT_THRESHOLD=0.8
# FACE_MATCH_THRESHOLD=0.55      FACE_DUPLICATE_THRESHOLD=0.60   # 0 turns the duplicate-face check off
